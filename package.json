{
  "name": "bao-signer",
  "version": "0.4.4",
  "description": "Passkey-first Nostr signing: WebAuthn PRF identity derivation, passkey-wrapped key storage, and a Fastify auth server.",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "default": "./dist/ui/index.js"
    }
  },
  "files": [
    "dist",
    "schema.sql",
    "README.md",
    "SECURITY.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@noble/curves": "^2.3.0",
    "@noble/hashes": "^2.2.0",
    "@noble/secp256k1": "^3.0.0",
    "@scure/bip39": "^2.3.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.0",
    "bech32": "^2.0.0",
    "jose": "^6.2.8",
    "nostr-tools": "^2.23.3"
  },
  "peerDependencies": {
    "fastify": "^5.0.0",
    "react": "^18 || ^19"
  },
  "peerDependenciesMeta": {
    "fastify": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "fastify": "^5.8.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.7.3",
    "vitest": "^4.1.2"
  },
  "keywords": [
    "nostr",
    "passkey",
    "webauthn",
    "prf",
    "signer",
    "secp256k1",
    "bao"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/baocommunity/bao-signer.git"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/client/index.js",
  "types": "./dist/client/index.d.ts"
}
